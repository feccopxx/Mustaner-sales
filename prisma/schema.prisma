generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum FieldVisibility {
  PUBLIC
  INTERNAL
}

enum MediaType {
  IMAGE
  PDF
  VIDEO
  DOCUMENT
  OTHER
}

enum MeetingMode {
  ONLINE
  FACE_TO_FACE
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  DISCORD
}

enum FollowUpStatus {
  PENDING
  CANCELLED
  SENT
}

model AppConfig {
  id           Int      @id @default(1)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Course {
  id               String        @id @db.VarChar(64)
  name             String
  shortDescription String        @default("")
  price            String        @default("")
  curriculum       String        @default("")
  howToSell        String        @default("")
  status           CourseStatus  @default(DRAFT)
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customFields     CustomField[]
  mediaLinks       MediaLink[]
  revisions        CourseRevision[]

  @@index([status, archivedAt])
  @@index([name])
}

model CustomField {
  id         String          @id @default(cuid())
  name       String
  content    String          @default("")
  visibility FieldVisibility @default(INTERNAL)
  position   Int             @default(0)
  courseId   String
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, name])
}

model GlobalField {
  id         String          @id @default(cuid())
  name       String          @unique
  content    String          @default("")
  visibility FieldVisibility @default(INTERNAL)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model MediaLink {
  id          String    @id @default(cuid())
  label       String
  url         String
  type        MediaType @default(OTHER)
  description String    @default("")
  position    Int       @default(0)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

model CourseRevision {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())
  @@index([courseId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([createdAt])
}

model AgentConfigurationDraft {
  id        String   @id @default("current")
  persona   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentConfigurationVersion {
  id            String   @id @default(cuid())
  version       Int      @unique
  persona       String   @db.Text
  sourceDraftId String
  publishedAt   DateTime @default(now())
}

model AgentConversation {
  id            String           @id @default(cuid())
  channel       String
  customerId    String
  state         Json
  lastInboundAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      AgentMessage[]
  batches       AgentMessageBatch[]
  followUps     AgentFollowUp[]

  @@unique([channel, customerId])
}

model AgentMessage {
  id              String            @id @default(cuid())
  sourceMessageId String
  kind            String
  normalizedText  String            @db.Text
  occurredAt      DateTime
  receivedAt      DateTime
  createdAt       DateTime          @default(now())
  conversationId  String
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  batchId         String?
  batch           AgentMessageBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([conversationId, sourceMessageId])
  @@index([conversationId, occurredAt])
}

model AgentMessageBatch {
  id             String            @id @default(cuid())
  status         String            @default("OPEN")
  flushAt        DateTime
  combinedInput  String            @default("") @db.Text
  responseText   String            @default("") @db.Text
  configurationVersion Int?
  generationStartedAt DateTime?
  generationToken String?
  processedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages       AgentMessage[]

  @@index([status, flushAt])
}

model MeetingReservation {
  id           String           @id @default(cuid())
  customerId   String
  customerName String
  phone        String
  mode         MeetingMode
  platform     MeetingPlatform?
  startsAt     DateTime         @unique
  endsAt       DateTime
  createdAt    DateTime         @default(now())
}

model AgentFollowUp {
  id             String            @id @default(cuid())
  stage          Int
  dueAt          DateTime
  status         FollowUpStatus    @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, stage])
  @@index([status, dueAt])
}

model AgentHandoffEvent {
  id             String   @id @default(cuid())
  type           String
  idempotencyKey String   @unique
  payload        Json
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?

  @@index([type, createdAt])
}
